# Copy to .env and fill in. Never commit the real .env.

# Host port the gateway listens on.
GATEWAY_PORT=8080

# Host interface the gateway binds to. Defaults to all interfaces for local
# dev — on company hardware this MUST be set to the internal network
# interface's IP (never left as 0.0.0.0), since the gateway is the only
# service in this stack meant to be reachable at all, and only internally.
# There is no application-level auth (see README.md "Deployment / network
# exposure") — this network boundary is the sole access control.
GATEWAY_BIND_HOST=0.0.0.0
